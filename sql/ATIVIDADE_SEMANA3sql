-- 01 Filtrar dependentes**********************************
/* 
Tarefa
Criar uma consulta que liste os dependentes que nasceram em abril, maio ou junho, ou tenham a letra "h" no nome.;
Adicione o código da consulta em sql/comandos.sql.
Regras de aceitação
Ordene primeiramente pelo nome do colaborador, depois pelo nome do dependente.
*/

SELECT colab.nome AS nome_colaborador, 
       d.nome AS nome_dependente, 
       d.data_nascimento                                   
FROM brh.colaborador c
INNER JOIN brh.dependente d ON c.matricula = d.colaborador
WHERE (EXTRACT(MONTH FROM d.data_nascimento) IN (4, 5, 6) OR d.nome LIKE '%h%')
ORDER BY c.nome, d.nome;

